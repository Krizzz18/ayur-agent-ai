# Supabase Configuration
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_publishable_key_here"
VITE_SUPABASE_URL="https://your_project_id.supabase.co"

# Gemini AI Configuration (Frontend - Vite)
# Get your API key from: https://makersuite.google.com/app/apikey
# IMPORTANT: Never commit your actual .env file to git!
VITE_GEMINI_API_KEY="your_gemini_api_key_here"

# Gemini AI Configuration (Flask Backend)
# This should be the same key as above, used by the Python backend
GEMINI_API_KEY="your_gemini_api_key_here"

# Flask Backend URL
# For local development: http://localhost:5000
# For production: your deployed Flask backend URL
VITE_FLASK_API_URL="http://localhost:5000"

# Resend Email API Key (for Supabase Edge Functions)
# Get your API key from: https://resend.com
RESEND_API_KEY="your_resend_api_key_here"
